
<%- layout("layouts/boilerplate") -%>


   <head>
    <link rel="stylesheet" href="/style.css">
   </head>

<body>

    

 
    <section class="job-search">
        <div class="container row">
            <h2>    Find Your Dream Job</h2>
            <form id="job-search-form" action="/jobportal/search" method="post">
                <div class="form-row justify-content-center search-section">
                    <div class="col-md-4 mb-3">
                        <input type="text" class="form-control" id="job-title" placeholder="Enter Your Skills" name="skills" required>
                        <div id="job-title-suggestions" class="suggestions"></div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <input type="text" class="form-control" id="location" placeholder="Enter Location " name ="location"required>
                        <div id="location-suggestions" class="suggestions"></div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>
    </section>

   

    
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    
    <script>
       
        const jobTitles = [
            "Software Engineering", "Data Science", "Machine Learning", "Artificial Intelligence", "Deep Learning",
            "Web Development", "Full Stack Developer", "UI/UX Design", "Cybersecurity", "Cloud Computing", 
            "Mobile App Development", "Game Development", "Digital Marketing", "Blockchain Development", 
            "Internet of Things (IoT)", "Data Analytics", "Computer Networks", "Computer Programming", 
            "Database Administration", "DevOps", "Big Data", "Business Intelligence", "Automation Testing", 
            "Augmented Reality (AR)", "Virtual Reality (VR)", "Augmented Reality Development", 
            "Game Design", "Robotics", "Natural Language Processing (NLP)", "Computer Graphics",
            "Python", "JavaScript", "Java", "C++", "C#", "Ruby", "Swift", "Kotlin", "PHP", "Go", 
            "Rust", "TypeScript", "HTML", "CSS", "SQL", "R", "MATLAB", "Shell Scripting", "Perl", "Scala",
            "Objective-C", "Lua", "Dart", "SQL Server", "MongoDB", "GraphQL", "React", "Angular", "Vue.js", 
            "Node.js", "Express.js", "Spring Boot", "Laravel", "Flask", "Django", "AngularJS", "Bootstrap",
            "TensorFlow", "PyTorch", "OpenCV", "Unity3D", "Unreal Engine"
        ];

        const locations = [
            "Mumbai", "Delhi", "Bangalore", "Hyderabad", "Chennai", "Pune", "Kolkata", "Ahmedabad", 
            "Chandigarh", "Gurgaon", "Noida", "Jaipur", "Surat", "Lucknow", "Kochi", "Indore", "Vadodara", 
            "Nagpur", "Coimbatore", "Visakhapatnam", "Patna", "Bhopal", "Kochi", "Mysore", "Agra", "Vijayawada", 
            "Nagaland", "Navi Mumbai", "Thane", "Dehradun", "Udaipur", "Raipur", "Madurai", "Guwahati", 
            "Ranchi", "Shimla", "Allahabad", "Kochi", "Amritsar", "Kanpur", "Bhubaneswar", "Bikaner"
        ];

        function showSuggestions(input, suggestionsList, type) {
            const value = input.value.toLowerCase();
            const suggestions = (type === 'job') ? jobTitles : locations;
            const filteredSuggestions = suggestions.filter(suggestion => suggestion.toLowerCase().includes(value));
            const suggestionsContainer = document.getElementById(suggestionsList);

            suggestionsContainer.innerHTML = ''; 
            if (value && filteredSuggestions.length > 0) {
                filteredSuggestions.forEach(suggestion => {
                    const div = document.createElement('div');
                    div.textContent = suggestion;
                    div.onclick = () => selectSuggestion(suggestion, input, suggestionsList);
                    suggestionsContainer.appendChild(div);
                });
                suggestionsContainer.style.display = 'block';
            } else {
                suggestionsContainer.style.display = 'none';
            }
        }

        function selectSuggestion(suggestion, input, suggestionsList) {
            let currentValue = input.value.trim();
            if (!currentValue.includes(suggestion)) {
                input.value = currentValue ? currentValue + ', ' + suggestion : suggestion;
            }
            document.getElementById(suggestionsList).style.display = 'none'; 
        }

        document.getElementById('job-title').addEventListener('input', function() {
            showSuggestions(this, 'job-title-suggestions', 'job');
        });

        document.getElementById('location').addEventListener('input', function() {
            showSuggestions(this, 'location-suggestions', 'location');
        });
    </script>

</body>
