<%- layout("layouts/boilerplate") -%>
<body>
    <div class="container row offset-2">
      <h1>Enter Your Details</h1>
     
    <form method="post" action="/jobportal" novalidate class="needs-validation mt-3 ">
      <!-- Name -->
      <div class="mb-3 col-md-8">
        <label for="name" class="form-label">Full Name</label>
        <input type="text" class="form-control" id="name" placeholder="Enter your full name" name="username" required>
      </div>
      <div class="col-md-8">
        <div class="mb-3  ">
        <label for="password" class="form-label">password</label>
        <input type="password" name="password"  class="form-control" id="password" required>
        <div class="invalid-feedback">password should be required</div>
        </div>
        </div>
      <!-- Contact Details -->
      <div class="mb-3 col-md-8">
        <label for="contact" class="form-label">Contact Number</label> 
        <input type="number" class="form-control" id="contact" placeholder="Enter your contact number" name="mobielNumber" min="10" max="10" required>
      </div>

      <!-- Email ID -->
      <div class="mb-3 col-md-8">
        <label for="email" class="form-label">Email ID</label>
        <input type="email" class="form-control" id="email" placeholder="Enter your email address" name="email" required>
      </div>

     

      <!-- Submit Button -->
      <button type="submit" class="btn btn-success">Submit</button>
      </form>
    </div>
    <script src="/script.js"></script>
    </body>