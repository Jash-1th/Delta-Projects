
<%- layout("layouts/boilerplate") -%>
  <style>
    body {
      background-color: #f8f9fa;
      padding: 20px;
    }

    .job-card {
      background-color: #fff;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin-bottom: 1.5rem;
    }

    .job-card h5 {
      color: #4caf50;
    }

    .job-card .skills {
      margin-top: 1rem;
    }

    .job-card .skills span {
      display: inline-block;
      background-color: #e0e0e0;
      padding: 0.5rem 1rem;
      border-radius: 20px;
      margin: 0.25rem;
      font-size: 0.9rem;
    }
  </style>
</head>
